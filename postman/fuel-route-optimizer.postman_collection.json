        "body": {
          "mode": "raw",
          "raw": "{\n  \"start\": \"Chicago, IL\",\n  \"finish\": \"Los Angeles, CA\",\n  \"stop_penalty\": 5\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
              "const isJson = (pm.response.headers.get(\"Content-Type\") || \"\").includes(\"application/json\");",
              "pm.test(\"response is JSON\", () => pm.expect(isJson, \"got HTML: check the URL ends with a slash and see the server log\").to.be.true);",
              "const r = isJson ? pm.response.json() : null;",
              "if (r) {",
              "  pm.test(\"gallons cover every mile\", () => pm.expect(r.total_gallons * 10).to.be.closeTo(r.total_driving_miles, 0.5));",
              "  pm.test(\"stop costs add up to the total\", () => { const s = r.fuel_stops.reduce((a, x) => a + x.cost, 0); pm.expect(s).to.be.closeTo(r.total_fuel_cost, 0.05); });",
              "  pm.test(\"at most one routing call\", () => pm.expect(r.meta.external_api_calls).to.be.at.most(1));",
              "  pm.test(\"stations are city-level\", () => r.fuel_stops.forEach(s => pm.expect(s.location.precision).to.eql(\"city\")));",
              "  pm.test(\"penalty reported in meta\", () => pm.expect(r.meta.stop_penalty_dollars).to.eql(5));",
              "}"
            ]
          }
        }
      ]
    },
