{
  "info": {
    "name": "Fuel Route Optimizer",
    "description": "Demo and checks for POST /api/route/. Start the server first: python manage.py runserver. Run in order: #4 and #5 rely on #3 being cached. Uncached route requests (#2, #3, #6) each use one ORS call.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base}}/health/",
          "host": [
            "{{base}}"
          ],
          "path": [
            "health",
            ""
          ]
        },
        "description": ""
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
              "const isJson = (pm.response.headers.get(\"Content-Type\") || \"\").includes(\"application/json\");",
              "pm.test(\"response is JSON\", () => pm.expect(isJson, \"got HTML: check the URL ends with a slash and see the server log\").to.be.true);",
              "const r = isJson ? pm.response.json() : null;",
              "if (r) {",
              "  pm.test(\"ORS key configured\", () => pm.expect(r.ors_key_configured).to.eql(true));",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Short route: Dallas -> Houston",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base}}/route/",
          "host": [
            "{{base}}"
          ],
          "path": [
            "route",
            ""
          ]
        },
        "description": "Under 500 miles: expect one fuel stop.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"start\": \"Dallas, TX\",\n  \"finish\": \"Houston, TX\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
              "const isJson = (pm.response.headers.get(\"Content-Type\") || \"\").includes(\"application/json\");",
              "pm.test(\"response is JSON\", () => pm.expect(isJson, \"got HTML: check the URL ends with a slash and see the server log\").to.be.true);",
              "const r = isJson ? pm.response.json() : null;",
              "if (r) {",
              "  pm.test(\"gallons cover every mile\", () => pm.expect(r.total_gallons * 10).to.be.closeTo(r.total_driving_miles, 0.5));",
              "  pm.test(\"stop costs add up to the total\", () => { const s = r.fuel_stops.reduce((a, x) => a + x.cost, 0); pm.expect(s).to.be.closeTo(r.total_fuel_cost, 0.05); });",
              "  pm.test(\"at most one routing call\", () => pm.expect(r.meta.external_api_calls).to.be.at.most(1));",
              "  pm.test(\"stations are city-level\", () => r.fuel_stops.forEach(s => pm.expect(s.location.precision).to.eql(\"city\")));",
              "}"
            ]
          }
        }
      ]
    },
