    },
    {
      "name": "4. Same route again (cached)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base}}/route/",
          "host": [
            "{{base}}"
          ],
          "path": [
            "route",
            ""
          ]
        },
        "description": "Run after #3: cache hit, zero routing calls, about 1 ms.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"start\": \"Chicago, IL\",\n  \"finish\": \"Los Angeles, CA\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
              "const isJson = (pm.response.headers.get(\"Content-Type\") || \"\").includes(\"application/json\");",
              "pm.test(\"response is JSON\", () => pm.expect(isJson, \"got HTML: check the URL ends with a slash and see the server log\").to.be.true);",
              "const r = isJson ? pm.response.json() : null;",
              "if (r) {",
              "  pm.test(\"gallons cover every mile\", () => pm.expect(r.total_gallons * 10).to.be.closeTo(r.total_driving_miles, 0.5));",
              "  pm.test(\"stop costs add up to the total\", () => { const s = r.fuel_stops.reduce((a, x) => a + x.cost, 0); pm.expect(s).to.be.closeTo(r.total_fuel_cost, 0.05); });",
              "  pm.test(\"at most one routing call\", () => pm.expect(r.meta.external_api_calls).to.be.at.most(1));",
              "  pm.test(\"stations are city-level\", () => r.fuel_stops.forEach(s => pm.expect(s.location.precision).to.eql(\"city\")));",
              "  pm.test(\"served from cache\", () => { pm.expect(r.meta.cache_hit).to.eql(true); pm.expect(r.meta.external_api_calls).to.eql(0); });",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "5. Equivalent spelling (cached, own query echoed)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base}}/route/",
          "host": [
            "{{base}}"
          ],
          "path": [
            "route",
            ""
          ]
        },
        "description": "Same places as #3, different spelling: shares the cache entry but returns its own query text.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"start\": \"chicago, illinois\",\n  \"finish\": \"los angeles, california\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
              "const isJson = (pm.response.headers.get(\"Content-Type\") || \"\").includes(\"application/json\");",
              "pm.test(\"response is JSON\", () => pm.expect(isJson, \"got HTML: check the URL ends with a slash and see the server log\").to.be.true);",
              "const r = isJson ? pm.response.json() : null;",
              "if (r) {",
              "  pm.test(\"gallons cover every mile\", () => pm.expect(r.total_gallons * 10).to.be.closeTo(r.total_driving_miles, 0.5));",
              "  pm.test(\"stop costs add up to the total\", () => { const s = r.fuel_stops.reduce((a, x) => a + x.cost, 0); pm.expect(s).to.be.closeTo(r.total_fuel_cost, 0.05); });",
              "  pm.test(\"at most one routing call\", () => pm.expect(r.meta.external_api_calls).to.be.at.most(1));",
              "  pm.test(\"stations are city-level\", () => r.fuel_stops.forEach(s => pm.expect(s.location.precision).to.eql(\"city\")));",
              "  pm.test(\"served from cache\", () => pm.expect(r.meta.cache_hit).to.eql(true));",
              "  pm.test(\"echoes this caller's text\", () => pm.expect(r.start.query).to.eql(\"chicago, illinois\"));",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "6. With $5 stop penalty",
