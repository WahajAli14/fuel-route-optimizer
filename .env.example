# Copy to .env and fill in. .env is never committed.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Free key from https://openrouteservice.org/dev/#/signup
ORS_API_KEY=
# driving-hgv (truck) by default; use driving-car as a fallback
ORS_PROFILE=driving-hgv
ORS_TIMEOUT_SECONDS=15

# Optional: use Redis for the response cache (in-memory cache otherwise)
# REDIS_URL=redis://localhost:6379/0

NOMINATIM_USER_AGENT=spotter-fuel-route-assessment
